name: dockercompose4321936019722765023
services:
  crazydayz.promo:
    build:
      context: C:\Users\User\source\repos\CrazyDayZ.Promo\CrazyDayZ.Promo\CrazyDayZ.Promo
      dockerfile: Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: CrazyDayZ.Promo
      target: base
    container_name: CrazyDayZ.Promo_1
    depends_on:
      promocodes.database:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ASPNETCORE_URLS: http://+:8080
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    expose:
      - "8080"
    image: crazydayzpromo:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net8.0/CrazyDayZ.Promo.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      app-network: null
    tty: true
    volumes:
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\CrazyDayZ.Promo\wwwroot
        target: /app/wwwroot
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\CrazyDayZ.Promo
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\CrazyDayZ.Promo
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\User\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
  frontend:
    build:
      context: C:\Users\User\source\repos\CrazyDayZ.Promo\DayZPromo
      dockerfile: Dockerfile
    environment:
      NODE_ENV: development
      REACT_APP_API_URL: http://localhost/api
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 3000
        published: "3000"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\DayZPromo
        target: /app
        bind:
          create_host_path: true
      - type: volume
        target: /app/node_modules
        volume: {}
  nginx:
    depends_on:
      crazydayz.promo:
        condition: service_started
        required: true
      frontend:
        condition: service_started
        required: true
    image: nginx:alpine
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 80
        published: "80"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\nginx\nginx.conf
        target: /etc/nginx/nginx.conf
        read_only: true
        bind:
          create_host_path: true
  promocodes.database:
    container_name: promocodes.database
    environment:
      POSTGRES_DB: promocodes
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\User\source\repos\CrazyDayZ.Promo\.containers\servers-db
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
networks:
  app-network:
    name: dockercompose4321936019722765023_app-network
    driver: bridge